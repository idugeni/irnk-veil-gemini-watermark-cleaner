{
  "name": "irnk-veil-gemini-watermark-cleaner",
  "version": "1.1.0",
  "description": "IRNK Veil cleans Gemini watermarks locally with precise visual processing.",
  "homepage": "https://irnk.codes/veil",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node src/build/run-vite-build.mjs",
    "package": "node src/build/run-vite-build.mjs && powershell Compress-Archive -Path dist/* -DestinationPath irnk-veil-v1.1.0.zip -Force",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.2.2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "postcss": "^8.5.24",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.7.0"
  }
}
